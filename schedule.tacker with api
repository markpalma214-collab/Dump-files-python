from fastapi import FastAPI, Depends, HTTPException
from app.API_PROJECT import models, schemas
from app.API_PROJECT.database import engine, SessionLocal
from sqlalchemy.orm import Session
from datetime import date, datetime

app =FastAPI()
models.Base.metadata.create_all(bind=engine)

def get_db():
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()

@app.post("/posts", response_model= schemas.Schedule_Response)
def Schedule_Maker(data: schemas.Schedule_Create, db: Session = Depends(get_db)):
    # create a condition first
    days_deadline = datetime.strptime(data.deadline, "%m/%d/%Y").date()
    days_left = (days_deadline-date.today()).days
    if days_left <= 1:
        priority = "URGENT"
    elif days_left <=2:
        priority = "HIGH"
    elif days_left <= -1:
        priority = "DEADLINE DUE"
    else:
        priority = "NORMAL"
    user = models.ScheduleTracker(
        subject = data.subject,
        title = data.title,
        deadline = data.deadline,
        priority = priority
    )
    db.add(user)
    db.commit()
    db.refresh(user)
    return user

@app.delete("posts"/{post_id}, response_model= schemas.Schedule_Response)
def delete_schedulemaker(post_id: int, db:Session = Depends(get_db)):
    database = db.query(models).filter(models.ScheduleTracker.id == post_id).first()
    if database is None:
        raise HTTPException(status_code=404,
                            detail="Schedule is not found.")
    db.remove(database)
    db.commit()
    return database

@app.put("posts"/{post_id}, response_model= schemas.Schedule_Response)
def update_schedulemaker(post_id:int, data:schemas.Schedule_Create, db:Session = Depends(get_db)):
    update_deadline = db.query(models).filter(models.ScheduleTracker.id == post_id).first()
    update_deadline.subject = data.subject
    update_deadline.title = data.title
    update_deadline.deadline = data.deadline
    days_deadline = datetime.strptime(data.deadline, "%m/%d/%Y").date()
    days_left = (days_deadline-datetime.today()).days
    if days_left < 0:
        raise HTTPException(status_code=404,
                            detail="DEADLINE IS ALREADY DUE")
    elif days_left <=1:
        priority = "URGENT"
    elif days_left <=3:
        priority = "HIGH"
    else:
        priority = "LOW"
    db.commit()
    db.refresh(update_deadline)
    return update_deadline

