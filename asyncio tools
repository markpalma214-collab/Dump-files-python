import asyncio
import random
import time
async def  multitasking(news, stocks, delay):
    
    print("initializing the tasks")
    rand_value = random.randint(2,5)
    weather_value = random.randint(25,40)
    await asyncio.sleep(rand_value)
    return {"weather":weather_value, "news": {news}, "stocks":{stocks}}

async def main():
    start = time.perf_counter()
    
    task1 = asyncio.create_task(multitasking("ABS-CBN", "350 pieces", 3))
    task2 = asyncio.create_task(multitasking("ABS-CBN", "350 pieces", 2))

    result1 = await task1
    result2 = await task2

    end = time.perf_counter()

    elapsed = end-start

    print("Task 1 result:", result1)
    print("Task 2 result:", result2)
    print(f"Total time taken: {elapsed:.2f} seconds")







